# =====================================================================
# AIMS Backend — configuration template.
# Copy to `.env` (never commit it) or inject through your secret manager.
# =====================================================================

# ===== App =====
APP_NAME=AIMS Backend
# development | production. Production turns on mandatory HTTPS, https-only CORS,
# disabled API docs, and refuses demo data.
APP_ENV=development
API_V1_PREFIX=/api/v1

# ===== Secrets =====
# PRODUCTION: REQUIRED, no default — the app will not start without a strong value.
# DEVELOPMENT / standalone EXE (APP_ENV != production): may be left EMPTY. A random key is
# then generated once and kept next to the database (aims_data/.dev_secret_key), so
# sessions survive restarts. A short/weak value only logs a warning there.
# Generate:  python -m app.cli gen-secret
#   or:      python -c "import secrets; print(secrets.token_urlsafe(64))"
# >= 32 chars, never a placeholder. Rotating it signs everyone out AND makes stored
# external-site passwords (crypto_util.py) undecryptable — re-enter those afterwards.
SECRET_KEY=

# ===== Tokens =====
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Login throttling =====
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15

# ===== First administrator =====
# Order of precedence while the users table is EMPTY:
#   1. BOOTSTRAP_ADMIN_* below (must satisfy the password policy: >= 12 chars, mixed, not common)
#   2. Development admin (outside production only): DEV_ADMIN_USERNAME / DEV_ADMIN_PASSWORD
#      (default admin / admin123). Controlled by ALLOW_DEV_ADMIN (default: on outside production,
#      REFUSED in production — startup fails if it is forced on there).
#   3. otherwise nobody can log in until:  python -m app.cli create-admin --username <name>
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# ALLOW_DEV_ADMIN=true
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=admin123
# Demo devices/alarms (never in production). Does not create any user.
SEED_DEMO_DATA=false

# 性能优化（2026-11-09，报告第 9 项）：启动后在后台线程预热 pandas，
# 第一次导入请求从约 1.2s 降到约 0.2s；代价是启动多约 0.5s、常驻内存
# 多约 50MB。默认关；独立 EXE（run_standalone.py）默认开。
# PREHEAT_PANDAS=true

# ===== Database =====
# Standalone / EXE mode (default): SQLite single file
DATABASE_URL=sqlite:///./aims_data/aims.db
AUTO_INIT_DB=true

# Docker / Production mode (PostgreSQL + TimescaleDB + pgvector).
# POSTGRES_PASSWORD has no default in docker-compose.yml — you must set it.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=aims
# POSTGRES_USER=aims
# POSTGRES_PASSWORD=<long random value>
# DATABASE_URL=postgresql+psycopg2://aims:<password>@db:5432/aims
# AUTO_INIT_DB=false

# ===== AI / LLM (optional, used by AI Center endpoints) =====
AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536

# ===== CORS whitelist =====
# Comma separated origins (scheme://host[:port]). "*" and "null" are rejected.
# Leave EMPTY if the UI is served by this backend at /ui (same origin).
# Production: https:// origins only.
CORS_ORIGINS=

# ===== HTTPS =====
# REQUIRE_HTTPS defaults to true in production, false otherwise.
# Production needs ONE of:
#   (a) direct TLS by the app:
# SSL_CERTFILE=/etc/aims/tls/fullchain.pem
# SSL_KEYFILE=/etc/aims/tls/privkey.pem
#   (b) TLS terminated by a reverse proxy (Caddy/nginx/ALB). List the proxy address(es)
#       whose X-Forwarded-Proto / X-Forwarded-For may be trusted ("*" only when the API
#       port is reachable exclusively through the proxy, e.g. a private docker network):
# TRUSTED_PROXY_IPS=10.0.0.5
# Optional Host-header whitelist:
# ALLOWED_HOSTS=aims.example.com
# API docs (/docs): on outside production, off in production unless set to true.
# ENABLE_DOCS=false

# ===== Upload limits =====
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_ROWS=500000
MAX_UPLOAD_COLUMNS=500

# ===== Server (standalone) =====
# Bind to loopback unless you deliberately expose the port.
HOST=127.0.0.1
PORT=8000
